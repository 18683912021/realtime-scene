# auto: use the real LLM when a key is configured, otherwise Mock.
# mock: force the deterministic local demo.
# live: require a configured LLM; falls back to Mock if missing.
APP_MODE=auto
PORT=8000
LOG_LEVEL=INFO

# OpenAI-compatible LLM provider (Qwen / DeepSeek / compatible gateway)
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=45
# Qwen 3.x hidden reasoning adds several seconds; keep it off for chat.
# Set to 1 only if you want the model to reason before every reply.
LLM_ENABLE_THINKING=0

# TTS: Edge Neural voice by default; macOS say is the offline fallback.
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_RATE=+4%
TTS_PITCH=+2Hz
TTS_MAC_VOICE=Tingting
TTS_MAC_RATE=180

# Tencent Cloud realtime ASR (server-side; never sent to the browser).
# When these are present the browser captures 16 kHz PCM and streams it to
# /ws/asr; otherwise the app falls back to browser Web Speech.
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=

# Legacy provider names are also accepted:
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
